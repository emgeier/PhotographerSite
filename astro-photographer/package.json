{
  "name": "glam-muse-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:images": "node scripts/check-images.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "visual:capture": "node visual/capture.mjs",
    "visual:report": "node visual/report.mjs",
    "test:lambda": "node --test \"aws/lambda/activecampaign/**/*.test.mjs\"",
    "check:guards": "node scripts/check-forbidden.mjs",
    "test": "vitest run && npm run check:guards",
    "test:watch": "vitest",
    "visual": "astro build && (astro preview --port 4321 & echo $! > .preview.pid; sleep 3; PREVIEW_URL=http://localhost:4321 node visual/capture.mjs && node visual/report.mjs; kill $(cat .preview.pid); rm -f .preview.pid)"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "latest",
    "astro": "latest",
    "gsap": "^3.15.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "jsdom": "27.4.0",
    "playwright": "latest",
    "vitest": "4.1.11"
  }
}
