---
// APEX STUDIO HUB — the top-level home for luisquintanastudio.com. This page is
// built at /home for now; it is DESTINED TO BECOME the root `/` index.astro when
// the paths-restructure runs (see astro-photographer/.agents/tasks/
// paths-restructure-plan.md). Do NOT overwrite src/pages/index.astro (the muse
// home) — this file is additive. It unites the Weddings and Glam Muse sections
// under one brand and matches Website/LQhomepage.png.
import Base from '../layouts/Base.astro';
import ApexHeader from '../components/ApexHeader.astro';
import ApexFooter from '../components/ApexFooter.astro';
import SiteMotion from '../components/SiteMotion.astro';
import Pic from '../components/Pic.astro';
import { getEntry } from 'astro:content';
import '../styles/apex.css';

// Reused existing imagery from public/images/ (no new binaries). Closest match
// per section; see .agents/tasks/apex-home-plan.md image table for the
// compromises (no wedding-couple / male-photographer / golden-hour assets exist).
// Images are CMS-editable via settings/apexhome.json; each falls back to its own
// /images/* default below so /home renders identically when the entry is absent.
const apex = await getEntry('settings', 'apexhome');
const heroImage = apex?.data.apexHeroImage ?? '/images/ms-hero.webp';          // warm glam beauty portrait
// Hero cross-fade carousel: 3 slides, each CMS-editable, with its own default.
// Slides 2/3 fall back to other existing portraits so the carousel has distinct
// frames out of the box; swap any of them in the CMS (apexhome.json).
const heroImage2 = apex?.data.apexHeroImage2 ?? '/images/ms-featured.webp';
const heroImage3 = apex?.data.apexHeroImage3 ?? '/images/ms-muse-2.webp';
const heroSlides = [
  { src: heroImage, alt: 'A woman in a flowing gown bathed in warm golden light.' },
  { src: heroImage2, alt: 'An editorial bridal portrait in soft light.' },
  { src: heroImage3, alt: 'A dramatic glam portrait in a dark gown.' },
];
const weddingsCardImage = apex?.data.apexWeddingsCardImage ?? '/images/ms-featured.webp'; // ivory bridal portrait (closest "weddings")
const glamCardImage = apex?.data.apexGlamCardImage ?? '/images/ms-muse-2.webp';    // black-top glam portrait
const beautyImage = apex?.data.apexBeautyImage ?? '/images/portfolio-banner.webp'; // woman in golden-hour landscape
const beautyInset = apex?.data.apexBeautyInsetImage ?? '/images/story-portrait.webp'; // intimate B&W inset
const meetImage = apex?.data.apexMeetImage ?? '/images/muses/portrait-04.webp'; // stand-in for B&W photographer portrait
const ctaImage = apex?.data.apexCtaImage ?? '/images/portfolio-banner.webp';  // warm golden-hour landscape
---
<Base
  title="Luis Quintana Studio — Photography"
  description="Life as stories. Wedding, engagement and glam portrait photography by Luis Quintana Studio — honest, artful imagery that captures the people and moments that matter."
>
  <main class="lq lq-page" id="main-content">
    <!-- 1 + 2. HEADER OVER HERO (single static slide) -->
    <section class="lq-hero">
      <ApexHeader />
      <!-- Hero cross-fade carousel: slides stacked, first is active by default
           so no-JS / reduced-motion shows a static first image. JS cross-fades
           between them and syncs the dot indicator below. -->
      <div class="lq-hero__slides" data-hero-carousel data-parallax>
        {heroSlides.map((slide, i) => (
          <div class={`lq-hero__slide${i === 0 ? ' is-active' : ''}`} data-hero-slide>
            <Pic src={slide.src} alt={slide.alt} priority={i === 0} sizes="100vw" />
          </div>
        ))}
      </div>
      <div class="lq-container lq-hero__content">
        <span class="lq-rule lq-hero__rule" data-hero-item aria-hidden="true"></span>
        <h1 class="lq-display lq-hero__title" data-hero-item>LIFE<br />AS<br />STORIES.</h1>
      </div>
      <!-- Carousel indicator: count reflects the active slide; dots are
           clickable controls the carousel script wires up and keeps in sync. -->
      <div class="lq-hero__indicator">
        <span class="lq-hero__count" data-hero-count aria-hidden="true">01 &mdash; 03</span>
        <div class="lq-hero__dots" role="tablist" aria-label="Hero slides">
          {heroSlides.map((_, i) => (
            <button
              type="button"
              class={`lq-hero__dot${i === 0 ? ' is-active' : ''}`}
              data-hero-dot
              aria-label={`Show slide ${i + 1} of ${heroSlides.length}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>
      <div class="lq-hero__keywords" aria-hidden="true">
        <span>People</span>
        <span>Places</span>
        <span>Emotions</span>
        <span>Beauty</span>
        <span>Forever</span>
        <span class="lq-rule"></span>
      </div>
    </section>

    <!-- 3. INTRO BAND -->
    <section class="lq-intro" aria-labelledby="lq-inlinetro-">
      <div class="lq-container" data-reveal>
        <p class="lq-eyebrow lq-eyebrow--center lq-intro__eyebrow">Life as stories.</p>
        <h2 id="lq-intro-line" class="lq-display lq-intro__line">Every Life Is <em>a Story</em> Worth Telling.</h2>
        <span class="lq-rule lq-intro__rule" aria-hidden="true"></span>
      </div>
    </section>

    <!-- 4. TWO BRAND CARDS -->
    <section class="lq-cards" aria-label="Explore the studio">
      <article class="lq-card" data-reveal>
        <div class="lq-card__image"><Pic src={weddingsCardImage} alt="A couple together on their wedding day." sizes="(max-width: 860px) 100vw, 50vw" /></div>
        <div class="lq-card__veil" aria-hidden="true"></div>
        <div class="lq-card__content">
          <h2 class="lq-display lq-card__title">Weddings &amp;<br />Engagements</h2>
          <p class="lq-card__sub">The day, as it felt.</p>
          <a class="lq-textlink" href="/weddings">Explore the experience</a>
        </div>
      </article>
      <article class="lq-card" data-reveal>
        <div class="lq-card__image"><Pic src={glamCardImage} alt="A woman in a dramatic black gown." sizes="(max-width: 860px) 100vw, 50vw" /></div>
        <div class="lq-card__veil" aria-hidden="true"></div>
        <div class="lq-card__content">
          <h2 class="lq-display lq-card__title">The Glam<br />Muse Series</h2>
          <p class="lq-card__sub">Your beauty, rediscovered.</p>
          <!-- /muse does not exist yet; it arrives with the paths-restructure. -->
          <a class="lq-textlink" href="/muse">Explore the experience</a>
        </div>
      </article>
    </section>

    <!-- 5. BEAUTY IN REAL MOMENTS -->
    <section class="lq-beauty" aria-labelledby="lq-beauty-title">
      <figure class="lq-beauty__media" data-reveal>
        <Pic src={beautyImage} alt="A bride in a sweeping gown overlooking a lake and mountains." sizes="(max-width: 860px) 100vw, 54vw" />
      </figure>
      <div class="lq-beauty__copy" data-reveal>
        <p class="lq-eyebrow lq-beauty__eyebrow">Authentic emotions</p>
        <h2 id="lq-beauty-title" class="lq-display lq-beauty__title">Beauty<br />In Real<br />Moments.</h2>
        <p class="lq-beauty__para">The fleeting, the intimate, the in-between. It’s in these moments that your story truly comes to life.</p>
        <figure class="lq-beauty__inset">
          <Pic src={beautyInset} alt="An intimate black-and-white moment between two people." sizes="(max-width: 860px) 100vw, 320px" />
        </figure>
      </div>
    </section>

    <!-- 6. MEET LUIS -->
    <section class="lq-meet" aria-labelledby="lq-meet-title">
      <figure class="lq-meet__media" data-reveal>
        <Pic src={meetImage} alt="A black-and-white portrait of Luis holding a camera." sizes="(max-width: 860px) 100vw, 46vw" />
      </figure>
      <div class="lq-meet__copy" data-reveal>
        <p class="lq-eyebrow lq-meet__eyebrow">The person behind the lens</p>
        <h2 id="lq-meet-title" class="lq-display lq-meet__title">Meet Luis.</h2>
        <p class="lq-meet__para">I’m a storyteller at heart, drawn to beauty, human connection, and the quiet moments that often mean the most. Through my lens, I strive to create images that feel honest, artful, and enduring — a reflection of the people and stories that inspire me.</p>
        <!-- /about may not exist yet on this branch; forward-looking link. -->
        <a class="lq-textlink" href="/about">Get to know me</a>
      </div>
    </section>

    <!-- 7. CLOSING CTA -->
    <section class="lq-cta" aria-labelledby="lq-cta-eyebrow">
      <div class="lq-cta__image" data-parallax>
        <Pic src={ctaImage} alt="A warm golden-hour landscape at sunset." sizes="100vw" />
      </div>
      <div class="lq-cta__veil" aria-hidden="true"></div>
      <div class="lq-container lq-cta__content" data-reveal>
        <p id="lq-cta-eyebrow" class="lq-eyebrow lq-cta__eyebrow">Your story begins here.</p>
        <span class="lq-rule lq-cta__rule" aria-hidden="true"></span>
        <!-- Mockup labels this "Inquire"; /inquire resolves today (/inquire
             arrives with the paths-restructure). -->
        <a class="lq-outline-btn" href="/inquire">Let’s connect</a>
      </div>
    </section>
  </main>
  <ApexFooter />
  <SiteMotion />
</Base>

<script>
  // Hero cross-fade carousel (apex /home). Progressive enhancement:
  // - First slide is already .is-active in the HTML, so with no JS (or if this
  //   script fails) the hero shows a static first image.
  // - Honors prefers-reduced-motion: no auto-advance; dots still let the visitor
  //   switch slides manually (an explicit choice is not "motion" the user didn't ask for).
  // - Cross-fade itself is pure CSS opacity transition; this script only toggles
  //   the .is-active class on slides + dots and updates the "01 — 03" count.
  (() => {
    const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
    if (!carousel) return;
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];
    const count = document.querySelector<HTMLElement>('[data-hero-count]');
    if (slides.length < 2) return; // nothing to cycle

    const total = slides.length;
    const pad = (n: number) => String(n).padStart(2, '0');
    let current = slides.findIndex((s) => s.classList.contains('is-active'));
    if (current < 0) current = 0;

    const show = (next: number) => {
      const i = ((next % total) + total) % total;
      if (i === current) return;
      slides[current]?.classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      dots[current]?.setAttribute('aria-selected', 'false');
      slides[i].classList.add('is-active');
      dots[i]?.classList.add('is-active');
      dots[i]?.setAttribute('aria-selected', 'true');
      if (count) count.innerHTML = `${pad(i + 1)} &mdash; ${pad(total)}`;
      current = i;
    };

    // Manual control via dots (available regardless of reduced-motion).
    dots.forEach((dot, i) => dot.addEventListener('click', () => { stop(); show(i); }));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    const SLIDE_MS = 6000; // slow, editorial pacing
    const start = () => {
      if (reduce.matches || timer !== undefined || total < 2) return;
      timer = window.setInterval(() => show(current + 1), SLIDE_MS);
    };
    const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } };

    // Pause auto-advance when the tab is hidden; resume when visible.
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    // React if the user toggles reduced-motion.
    reduce.addEventListener?.('change', () => (reduce.matches ? stop() : start()));

    start();
  })();
</script>
