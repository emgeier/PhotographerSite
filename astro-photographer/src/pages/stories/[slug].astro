---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('muses');
  return entries.map(e => ({ params: { slug: e.id }, props: { muse: e.data } }));
}

const { muse } = Astro.props;
const first = muse.name.charAt(0) + muse.name.slice(1).toLowerCase();
const tagUpper = muse.tagline.toUpperCase();

const gallery = muse.gallery;
---
<Base title={`${first} — Muse Stories — The Glam Muse Series`} description={`${muse.number}: ${muse.tagline} ${first}'s story in The Glam Muse Series.`}>
  <main>
    <section class="st-hero">
      <Header/>
      <div class="st-hero-row">
        <div class="st-hero-copy">
          <p class="eyebrow st-hero-eyebrow">{muse.number}</p>
          <h1 class="display st-hero-name">{muse.name}</h1>
          <p class="st-hero-tag">{tagUpper}</p>
          <span class="st-rule"></span>
          <p class="st-hero-para">{first} {muse.heroPara}</p>
          <a class="st-hero-link" href="#st-story">HER STORY <span aria-hidden="true">&darr;</span></a>
        </div>
        <img class="st-hero-photo" src={muse.heroImage} alt={`${first} hero portrait placeholder`} />
      </div>
    </section>

    <section class="st-intro" id="st-story">
      <div class="wrap st-intro-row">
        <div class="st-intro-head">
          <h2 class="display st-intro-title">BEFORE THE CAMERA,<br/>THERE WAS HER STORY.</h2>
          <span class="st-rule st-rule-wide"></span>
        </div>
        <p class="st-intro-para">{muse.introPara}</p>
      </div>
    </section>

    <section class="st-mosaic">
      <div class="wrap st-mosaic-grid">
        {gallery.map((src, i) => (
          <figure class={`st-tile st-tile-${i+1}`}><img src={src} alt={`${first} gallery portrait ${i+1}`} /></figure>
        ))}
        <div class="st-caption st-caption-a">
          <p class="display st-caption-text">A DIFFERENT<br/>PERSPECTIVE.</p>
          <span class="st-rule"></span>
        </div>
        <div class="st-caption st-caption-b">
          <p class="display st-caption-text">QUIET<br/>MOMENTS. REAL<br/>EMOTIONS. ALWAYS HER.</p>
          <span class="st-rule"></span>
        </div>
      </div>
    </section>

    <section class="st-transform">
      <div class="wrap st-transform-row">
        <div class="st-transform-copy">
          <p class="eyebrow st-transform-eyebrow">THE TRANSFORMATION</p>
          <h2 class="display st-transform-title">SHE WAS<br/>ALWAYS THERE.</h2>
          <span class="st-rule"></span>
          <p class="st-transform-para">{muse.transformPara}</p>
          <p class="st-transform-caps">NOT TRANSFORMED. REVEALED.</p>
        </div>
        <div class="st-transform-pair">
          <figure><img src={muse.beforeImage} alt={`${first} before portrait placeholder`} /><figcaption>BEFORE</figcaption></figure>
          <figure><img src={muse.afterImage} alt={`${first} after portrait placeholder`} /><figcaption>AFTER</figcaption></figure>
        </div>
      </div>
    </section>

    <section class="st-motion">
      <img class="st-motion-photo" src={muse.motionImage} alt={`${first} short film still placeholder`} />
      <div class="wrap st-motion-row">
        <div class="st-motion-copy">
          <h2 class="display st-motion-title">{muse.name},<br/>IN MOTION.</h2>
          <p class="eyebrow st-motion-sub">A SHORT FILM</p>
          <span class="st-rule st-rule-light"></span>
        </div>
        <a class="st-video" href="#" aria-label="Press play">
          <span class="st-play"></span>
          <span class="st-video-caption">PRESS PLAY</span>
        </a>
      </div>
    </section>

    <section class="st-seen">
      <div class="wrap st-seen-copy">
        <h2 class="display st-seen-title">You&rsquo;ve Seen Her Story.</h2>
        <p class="st-seen-italic">Now imagine yours.</p>
        <span class="st-rule st-rule-center"></span>
      </div>
    </section>

    <section class="st-cta">
      <div class="wrap st-cta-row">
        <div class="st-cta-copy">
          <p class="eyebrow st-cta-eyebrow">THE GLAM MUSE SERIES</p>
          <h2 class="display st-cta-title">WHAT COULD<br/>YOUR STORY LOOK LIKE?</h2>
          <span class="st-rule"></span>
          <p class="st-cta-sub">Every Muse begins with a conversation.</p>
        </div>
        <div class="st-cta-action">
          <p class="st-cta-ask">ARE YOU THE NEXT MUSE?</p>
          <a class="st-cta-button" href="/contact">BOOK YOUR CONSULTATION <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer/>
</Base>
