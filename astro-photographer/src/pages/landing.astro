---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteMotion from '../components/SiteMotion.astro';
import Pic from '../components/Pic.astro';
import '../styles/codex-base.css';
import '../styles/codex-content.css';

// A single-muse landing page (modeled on the "Landing Page" mockup, featuring
// Kaylee). Content/images below are the defaults; they can be moved to a
// settings/landing.json CMS entry later with the same getEntry() pattern.
const museEyebrow = 'Muse story';
const museName = 'Kaylee';
const museSub = 'A story of confidence, freedom, and rediscovery.';
const museLede = 'A real story, real moments, and portraits that celebrate who she is and who she’s becoming.';
const heroImage = '/images/ms-muse-3.webp';

const filmPoster = '/images/ms-motion.webp';
const filmEyebrow = 'The film';
const filmTitle = 'A story in motion.';
const filmCopy = 'Movement, laughter, quiet moments. A deeper look into Kaylee’s experience with The Glam Muse Series.';
const filmVideoUrl = '';

const galleryEyebrow = 'The portraits';
const galleryName = 'Kaylee';
const gallerySub = 'A collection of moments that feel like her.';
// 10 portraits for the 2×5 grid (clickable lightbox).
const gallery = [
  '/images/muses/portrait-05.webp', '/images/muses/portrait-06.webp', '/images/muses/portrait-07.webp',
  '/images/muses/portrait-08.webp', '/images/muses/portrait-09.webp', '/images/muses/portrait-01.webp',
  '/images/muses/portrait-02.webp', '/images/muses/portrait-03.webp', '/images/muses/portrait-04.webp',
  '/images/ms-muse-3.webp',
];
const galleryCaptions = [
  'A quiet gaze. An entirely personal kind of presence.',
  'The simple beauty of feeling entirely yourself.',
  'Room for stillness. Space to be seen.',
  'A pause. A breath. A fresh perspective.',
  'Softness has a strength all its own.',
  'The familiar, seen in a new way.',
  'The moments between the poses.',
  'Light, movement, and the woman she already is.',
  'Not transformed. Revealed.',
  'Her story, in a single frame.',
];
const captionFor = (i: number) => galleryCaptions[i % galleryCaptions.length];

const deserveEyebrow = 'From one muse to another';
const deserveTitle = 'You deserve this.';
const deservePara1 = 'This experience is about more than beautiful portraits. It’s about giving yourself permission to be seen, to feel confident, and to celebrate you — exactly as you are right now.';
const deservePara2 = 'My hope is that my story inspires you to take this step for yourself, because every woman deserves to feel beautiful, confident, and empowered.';
const deserveSignature = 'Kaylee';
const deserveImage = '/images/home-portrait.webp';

const steps = [
  { n: '01', t: 'LET’S TALK', p: 'A 15–20 minute Zoom call to understand your vision, preferences, and what makes you, uniquely you.' },
  { n: '02', t: 'YOUR SESSION', p: 'A relaxed, guided portrait experience with professional hair and makeup, up to 5 looks.' },
  { n: '03', t: 'THE REVEAL', p: 'A private, same-day unveiling of your portraits — a celebration of you, with options for artwork and collections.' },
];

const ctaTitle = 'It’s time to tell your story.';
const ctaCopy = 'You deserve to see yourself differently — and this is where it begins.';
const ctaButton = 'Book your consultation';
const ctaImage = '/images/home-closing.webp';
---
<Base
  title="Kaylee — A Muse Story — The Glam Muse Series"
  description="A real story, real moments, and portraits that celebrate who she is and who she’s becoming."
>
  <main id="main-content">
    <!-- HERO: muse-story masthead (eyebrow + big name + sub + lede + CTA, portrait right). -->
    <section class="lp-hero hero" aria-labelledby="lp-hero-title">
      <Header />
      <div class="hero__image lp-hero__image" data-hero-image data-parallax>
        <Pic src={heroImage} alt={`A portrait of ${museName}.`} priority sizes="100vw" />
      </div>
      <div class="hero__veil lp-hero__veil" aria-hidden="true"></div>
      <div class="container hero__content lp-hero__content">
        <p class="eyebrow lp-hero__eyebrow" data-hero-item>{museEyebrow}</p>
        <h1 id="lp-hero-title" class="hero__title lp-hero__name">
          <span class="line-mask"><span data-hero-line>{museName}</span></span>
        </h1>
        <p class="lp-hero__sub" data-hero-item>{museSub}</p>
        <p class="lp-hero__lede" data-hero-item>{museLede}</p>
        <a class="button" href="#lp-portraits" data-hero-item>Discover my story</a>
      </div>
    </section>

    <!-- FILM BAND: full-bleed dark poster + overlay, play affordance. -->
    <section class="lp-film" aria-labelledby="lp-film-title">
      <div class="lp-film__image" data-parallax>
        <Pic src={filmPoster} alt="A still from the muse film." sizes="100vw" />
      </div>
      <div class="lp-film__veil" aria-hidden="true"></div>
      <div class="container lp-film__content" data-reveal>
        <p class="eyebrow">{filmEyebrow}</p>
        <h2 id="lp-film-title" class="display-title lp-film__title">{filmTitle}</h2>
        <p class="lp-film__copy">{filmCopy}</p>
        {filmVideoUrl ? (
          <a class="button lp-film__play" href={filmVideoUrl} target="_blank" rel="noopener noreferrer">
            <span class="lp-film__play-icon" aria-hidden="true"></span> Watch the film
          </a>
        ) : (
          <span class="button lp-film__play" aria-disabled="true">
            <span class="lp-film__play-icon" aria-hidden="true"></span> Watch the film
          </span>
        )}
      </div>
    </section>

    <!-- PORTRAITS: heading row + 2×5 clickable gallery (lightbox popup). -->
    <section class="lp-portraits" id="lp-portraits" aria-labelledby="lp-portraits-title">
      <div class="content-container">
        <div class="lp-portraits__head" data-reveal>
          <div>
            <p class="eyebrow">{galleryEyebrow}</p>
            <h2 id="lp-portraits-title" class="display-title lp-portraits__name">{galleryName}</h2>
          </div>
          <p class="lp-portraits__sub">{gallerySub}</p>
          <p class="eyebrow lp-portraits__hint">Click any photo<br />to explore</p>
        </div>
        <div class="lp-grid">
          {gallery.map((src, i) => (
            <button
              type="button"
              class="lp-tile"
              data-gallery-item
              data-caption={captionFor(i)}
              data-reveal
              aria-label={`View ${galleryName} portrait ${i + 1} of ${gallery.length}`}
            >
              <img src={src} alt={`${galleryName} portrait ${i + 1}`} />
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- YOU DESERVE THIS: editorial two-column with signature. -->
    <section class="lp-deserve" aria-labelledby="lp-deserve-title">
      <div class="content-container lp-deserve__row">
        <div class="lp-deserve__copy" data-reveal>
          <p class="eyebrow">{deserveEyebrow}</p>
          <h2 id="lp-deserve-title" class="display-title lp-deserve__title">{deserveTitle}</h2>
          <span class="short-rule" aria-hidden="true"></span>
          <p class="lp-deserve__para">{deservePara1}</p>
          <p class="lp-deserve__para">{deservePara2}</p>
          <p class="lp-deserve__signature">{deserveSignature}</p>
        </div>
        <figure class="lp-deserve__photo image-frame" data-parallax>
          <Pic src={deserveImage} alt={`${deserveSignature} in a quiet, confident moment.`} sizes="(max-width: 768px) 100vw, 50vw" />
        </figure>
      </div>
    </section>

    <!-- PROCESS: 3-step. -->
    <section class="lp-process" aria-labelledby="lp-process-title">
      <div class="content-container">
        <div class="lp-process__head" data-reveal>
          <p class="eyebrow">Your turn</p>
          <h2 id="lp-process-title" class="display-title">A simple, meaningful process.</h2>
        </div>
        <ol class="lp-process__steps">
          {steps.map((s) => (
            <li class="lp-step" data-reveal>
              <span class="lp-step__number" aria-hidden="true">{s.n}</span>
              <span class="short-rule" aria-hidden="true"></span>
              <h3>{s.t}</h3>
              <p>{s.p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- CLOSING CTA: full-bleed image + overlaid copy + button. -->
    <section class="lp-cta" id="contact" aria-labelledby="lp-cta-title">
      <div class="lp-cta__image" data-parallax>
        <Pic src={ctaImage} alt="A joyful closing portrait." sizes="100vw" />
      </div>
      <div class="lp-cta__veil" aria-hidden="true"></div>
      <div class="content-container lp-cta__content" data-reveal>
        <h2 id="lp-cta-title" class="display-title lp-cta__title">{ctaTitle}</h2>
        <p class="lp-cta__copy">{ctaCopy}</p>
        <a class="button" href="/contact">{ctaButton}</a>
      </div>
    </section>
  </main>
  <Footer />
  <SiteMotion />

  <!-- Portrait lightbox — same contract initStoryGallery() requires. -->
  <dialog class="dialog gallery-dialog" id="st-gallery-dialog" aria-labelledby="st-gallery-label">
    <form method="dialog">
      <button class="dialog-close dialog-close--light" type="submit" aria-label="Close portrait viewer">
        <span aria-hidden="true">×</span>
      </button>
    </form>
    <div class="gallery-dialog__heading">
      <p class="eyebrow" id="st-gallery-label">{galleryName}</p>
    </div>
    <div class="gallery-stage">
      <button class="gallery-arrow" type="button" data-st-gallery-prev aria-label="Previous portrait">
        <span aria-hidden="true">←</span>
      </button>
      <figure>
        <img id="st-gallery-image" class="gallery-stage__image" src={gallery[0]} alt={`${galleryName} portrait`} />
        <figcaption id="st-gallery-caption">{captionFor(0)}</figcaption>
      </figure>
      <button class="gallery-arrow" type="button" data-st-gallery-next aria-label="Next portrait">
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <p id="st-gallery-count" class="gallery-count" aria-live="polite">01 / {String(gallery.length).padStart(2, '0')}</p>
  </dialog>
  <script>
    import { initStoryGallery } from '../scripts/portfolio.ts';
    initStoryGallery();
  </script>
</Base>
