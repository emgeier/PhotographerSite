<Base
  title="Love Stories — Luis Quintana Studio"
  description="Every love has a story. These are some of the ones I’ve had the honor of telling."
>
  <main class="wd wd-page" id="main-content">
    <!-- HERO -->
    <section class="wd-hero wd-subhero">
      <WeddingsHeader />
      <div class="wd-hero__image" data-parallax>
        <Pic src={heroImage} alt="A couple at a lakeside villa at golden hour." priority sizes="100vw" />
      </div>
      <div class="wd-hero__veil" aria-hidden="true"></div>
      <div class="wd-container wd-hero__content">
        <h1 class="wd-display wd-subhero__title wd-subhero__title--stack" data-hero-item>Love<br />Stories</h1>
        <p class="wd-hero__lede" data-hero-item>Every love has a story. These are some of the ones I’ve had the honor of telling.</p>
        <a class="wd-textlink wd-subhero__scroll" href="#wd-journal" data-hero-item style="color: var(--ivory);">Scroll to explore</a>
      </div>
    </section>

    <!-- FEATURED LOVE STORY -->
    <section class="wd-featured" aria-labelledby="wd-featured-title">
