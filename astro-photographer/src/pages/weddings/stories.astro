---
import Base from '../../layouts/Base.astro';
import WeddingsHeader from '../../components/WeddingsHeader.astro';
import WeddingsFooter from '../../components/WeddingsFooter.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import { getCollection, getEntry } from 'astro:content';
import '../../styles/wedding.css';

const wed = await getEntry('settings', 'weddings-stories');
const entries = await getCollection('weddingStories');
const featured = entries.find((e) => e.data.featured)!;
const heroImage = wed?.data.wedStoriesHeroImage ?? '/images/home-hero.webp';
const featuredPhoto = featured.data.cardImage;

// Grid: all non-featured stories, driven by the content collection so every
// card links to a real /weddings/stories/<slug>.
const stories = entries
  .filter((e) => !e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ type: e.data.type, names: e.data.names, place: e.data.place, img: e.data.cardImage, slug: e.id }));
const ctaImage = wed?.data.wedStoriesCtaImage ?? '/images/portfolio-banner.webp';
---
<Base
  title="Love Stories — Luis Quintana Studio"
  description="Every love has a story. These are some of the ones I’ve had the honor of telling."
>
  <main class="wd wd-page" id="main-content">
    <!-- HERO -->
    <section class="wd-hero wd-subhero">
      <WeddingsHeader />
      <div class="wd-hero__image" data-parallax>
        <Pic src={heroImage} alt="A couple at a lakeside villa at golden hour." priority sizes="100vw" />
      </div>
      <div class="wd-hero__veil" aria-hidden="true"></div>
      <div class="wd-container wd-hero__content">
        <h1 class="wd-display wd-subhero__title wd-subhero__title--stack" data-hero-item>Love<br />Stories</h1>
        <p class="wd-hero__lede" data-hero-item>Every love has a story. These are some of the ones I’ve had the honor of telling.</p>
        <a class="wd-textlink wd-subhero__scroll" href="#wd-journal" data-hero-item style="color: var(--ivory);">Scroll to explore</a>
      </div>
    </section>

    <!-- FEATURED LOVE STORY -->
    <section class="wd-featured" aria-labelledby="wd-featured-title">
      <!-- Featured photo hidden until real galleries are ready (copy kept). -->
      <div class="wd-container wd-featured__row wd-featured__row--soon">
        <div class="wd-featured__copy" data-reveal>
          <p class="wd-eyebrow">Featured love story</p>
          <h2 id="wd-featured-title" class="wd-display wd-featured__title">A love story,<br />beautifully told.</h2>
          <p class="wd-featured__names">Alex &amp; Taylor</p>
          <p class="wd-featured__place">Lake Como, Italy</p>
          <p class="wd-featured__para">A celebration filled with heartfelt moments, breathtaking views, and a love that brought together family and friends from around the world. Their wedding day was a perfect reflection of who they are — elegant, joyful, and deeply meaningful.</p>
          <a class="wd-textlink" href={`/weddings/stories/${featured.id}`}>View their story</a>
        </div>
      </div>
    </section>

    <!-- THE JOURNAL -->
    <section class="wd-journal" id="wd-journal" aria-labelledby="wd-journal-title">
      <div class="wd-container">
        <div class="wd-journal__head" data-reveal>
          <p class="wd-eyebrow wd-journal__eyebrow">The journal</p>
          <h2 id="wd-journal-title" class="wd-display wd-journal__title">Stories worth remembering.</h2>
          <p class="wd-journal__intro">From quiet, intimate moments to unforgettable celebrations, explore the stories of couples whose love I’ve had the privilege to document.</p>
          <div class="wd-journal__tabs" role="tablist" aria-label="Filter stories">
            <span class="wd-journal__tab is-active">All Stories</span>
            <span class="wd-journal__tab">Weddings</span>
            <span class="wd-journal__tab">Engagements</span>
          </div>
        </div>
        <!-- Journal photo grid hidden until real love stories are ready; show a
             "Coming soon" placeholder. To restore, bring back the
             {stories.map(...)} grid + "Load more" (stories is still computed). -->
        <div class="wd-journal__soon" data-reveal>
          <p class="wd-eyebrow wd-eyebrow-no-line wd-journal__soon-eyebrow">Coming soon</p>
          <p class="wd-journal__soon-text">New love stories are being prepared and will appear here soon.</p>
        </div>
      </div>
    </section>

    <!-- CLOSING BAND -->
    <section class="wd-cta wd-cta--legacy" aria-labelledby="wd-next-title">
      <div class="wd-cta__image" data-parallax>
        <Pic src={ctaImage} alt="A couple overlooking the lake at sunset." sizes="100vw" />
      </div>
      <div class="wd-cta__veil" aria-hidden="true"></div>
      <div class="wd-container wd-cta__content" data-reveal>
        <p class="wd-eyebrow wd-cta__eyebrow">Your story is next</p>
        <h2 id="wd-next-title" class="wd-display wd-cta__title">Every love deserves to be remembered.</h2>
        <p class="wd-cta__para">Your story is unlike anyone else’s. Let’s create photographs that preserve the beauty of how it felt.</p>
        <a class="wd-btn" href="/weddings/inquire">Inquire <span class="wd-btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <WeddingsFooter />
  <SiteMotion />
</Base>
