---
import Base from '../../layouts/Base.astro';
import WeddingsHeader from '../../components/WeddingsHeader.astro';
import WeddingsFooter from '../../components/WeddingsFooter.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import { getCollection, getEntry } from 'astro:content';
import '../../styles/wedding.css';

// Weddings home — its own brand/look (Luis Quintana Studio). Served at
// weddings.luisquintanastudio.com/ via the CloudFront host rewrite, and at
// /weddings. Section images are CMS-editable via settings/weddings-home.json;
// each falls back to its original path so the page renders identically absent.
const wed = await getEntry('settings', 'weddings-home');
const heroImage = wed?.data.wedHomeHeroImage ?? '/images/home-hero.webp';
const philoImage = wed?.data.wedHomePhiloImage ?? '/images/story-portrait.webp';
const weddingsCardImage = wed?.data.wedHomeWeddingsCardImage ?? '/images/portfolio-closing.webp';
const engagementsCardImage = wed?.data.wedHomeEngagementsCardImage ?? '/images/ms-muse-2.webp';
const aboutImage = wed?.data.wedHomeAboutImage ?? '/images/portrait.webp';
const ctaImage = wed?.data.wedHomeCtaImage ?? '/images/home-closing.webp';

// The experience step photos are shared with the /weddings/experience page:
// both read wedExperienceStepImages from the weddings-experience settings, so
// editing them once in the CMS updates both sections. Copy differs per page.
const expSettings = await getEntry('settings', 'weddings-experience');
const stepImageDefaults = ['/images/muses/portrait-01.webp', '/images/muses/portrait-02.webp', '/images/muses/portrait-03.webp'];
const stepImages = expSettings?.data.wedExperienceStepImages?.length ? expSettings.data.wedExperienceStepImages : stepImageDefaults;
const steps = [
  { n: '01', t: 'Consultation', p: 'It begins with a conversation. I want to understand your vision, the people closest to you, and the personal details that make your celebration unique.', img: stepImages[0] ?? stepImageDefaults[0] },
  { n: '02', t: 'Planning', p: 'Every celebration has its own rhythm. Together, we will shape a photography timeline that complements the flow of your day, making room for beautiful portraits and spontaneity.', img: stepImages[1] ?? stepImageDefaults[1] },
  { n: '03', t: 'Your Day', p: 'Enjoy the celebration you have imagined. I will offer guidance when needed and work unobtrusively as the day unfolds, preserving the genuine connections and emotions that make it unforgettable.', img: stepImages[2] ?? stepImageDefaults[2] },
];

const loveStories = (await getCollection('weddingStories'))
  .filter((e) => !e.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
  .map((e) => ({ name: e.data.names, img: e.data.cardImage, slug: e.id }));
---
<Base
  title="Weddings & Engagements — Luis Quintana Studio"
  description="Honest moments, meaningful connections, and a story told with intention. Wedding and engagement photography by Luis Quintana Studio."
>
  <main class="wd wd-page" id="main-content">
    <!-- HERO -->
    <section class="wd-hero">
      <WeddingsHeader />
      <div class="wd-hero__image wd-hero__image_home" data-parallax>
        <Pic src={heroImage} alt="A couple at golden hour overlooking a lake and mountains." priority sizes="100vw" />
      </div>
      <div class="wd-hero__veil" aria-hidden="true"></div>
      <div class="wd-container wd-hero__content">
        <h1 class="wd-display wd-hero__title" data-hero-item>The day,<br /><em>as it felt.</em></h1>
        <p class="wd-hero__lede" data-hero-item>Elegant, real, unmistakably yours.</p>
        <p class="wd-hero__lede" data-hero-item>The anticipation, the celebration, and the moments you never saw coming.</p>
        <p class="wd-hero__lede" data-hero-item>Beautifully captured. Deeply felt. Forever remembered.</p>
        <a class="wd-btn" href="/weddings/inquire" data-hero-item>Inquire <span class="wd-btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="wd-philo" aria-labelledby="wd-philo-title">
      <figure class="wd-philo__photo" data-reveal>
        <Pic src={philoImage} alt="A couple in a close, candid black-and-white moment." sizes="(max-width: 860px) 100vw, 50vw" />
      </figure>
      <div class="wd-philo__copy" data-reveal>
        <p class="wd-eyebrow">Our philosophy</p>
        <h2 id="wd-philo-title" class="wd-display wd-philo__title">Some moments<br />stay <em>forever.</em></h2>
        <p class="wd-philo__para">There is beauty in every detail, but the true essence of a wedding lives in the people, the connections, and the emotions that make it unforgettable. I approach each celebration with an editorial eye and a deep appreciation for what is genuine, creating photographs that are as personal as they are timeless.</p>
      </div>
    </section>

    <!-- TWO FEATURE CARDS -->
    <section class="wd-cards" aria-label="Weddings and engagements">
      <article class="wd-card" data-reveal>
        <div class="wd-card__image"><Pic src={weddingsCardImage} alt="A bride on grand stone steps framed by florals." sizes="(max-width: 860px) 100vw, 50vw" /></div>
        <div class="wd-card__veil" aria-hidden="true"></div>
        <div class="wd-card__content">
          <p class="wd-eyebrow wd-card__eyebrow">Weddings</p>
          <h2 class="wd-display wd-card__title">A day<br />unlike any other.</h2>
          <p class="wd-card__para">Your wedding is an expression of your love, your vision, and the people closest to you. From the atmosphere you've imagined to the emotions that unfold, every detail becomes part of a celebration that is entirely his own.</p>
          <a class="wd-textlink" href="/weddings/portfolio">Explore weddings</a>
        </div>
      </article>
      <article class="wd-card" data-reveal>
        <div class="wd-card__image"><Pic src={engagementsCardImage} alt="A couple embracing with a city skyline behind them." sizes="(max-width: 860px) 100vw, 50vw" /></div>
        <div class="wd-card__veil" aria-hidden="true"></div>
        <div class="wd-card__content">
          <p class="wd-eyebrow wd-card__eyebrow">Engagements</p>
          <h2 class="wd-display wd-card__title">Before<br />the vows.</h2>
          <p class="wd-card__para">Before the wedding day, there is a chapter worth celebrating in its own right. An opportunity to slow down, enjoy being together, and create beautful portraits that reflect you connection, your personalities, and the excitement of everything still to come.</p>
          <a class="wd-textlink" href="/weddings/engagements">Explore engagements</a>
        </div>
      </article>
    </section>
    <!-- OUR APPROACH -->
    <section class="wd-approach" aria-labelledby="wd-approach-title">
      <div class="wd-container">
        <div class="wd-approach__head" data-reveal>
          <p class="wd-eyebrow wd-approach__eyebrow">Our approach</p>
          <h2 id="wd-approach-title" class="wd-display wd-approach__title">An artistic approach,<br />to every detail.</h2>
          <p class="wd-approach__intro">A beautfully photographed wedding begins long before the day itself. I take the time to understand your vision, anticipate what matters, and approach each celebration with preparation and intention.</p>
          <p class="wd-approach__intro">There is an art to knowing when to offer direction and when to let moments unfold naturally. My intention is to create an experience that feels effortless to be fully present while I document your celebration with artistry and care.</p>
        </div>
        <ol class="wd-approach__steps">
          {steps.map((s) => (
            <li class="wd-acard" data-reveal>
              <figure class="wd-acard__photo"><Pic src={s.img} alt={`${s.t} — part of the experience.`} sizes="(max-width: 900px) 100vw, 33vw" /></figure>
              <p class="wd-acard__num"><span>{s.n}</span><span class="wd-acard__dash" aria-hidden="true"></span></p>
              <h3 class="wd-acard__h">{s.t}</h3>
              <p class="wd-acard__p">{s.p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="wd-about" aria-labelledby="wd-about-title">
      <figure class="wd-about__photo" data-reveal>
        <Pic src={aboutImage} alt="A portrait of Luis." sizes="(max-width: 860px) 100vw, 50vw" />
      </figure>
      <div class="wd-about__copy" data-reveal>
        <p class="wd-eyebrow">About</p>
        <h2 id="wd-about-title" class="wd-display wd-about__title">About Luis.</h2>
        <p class="wd-about__para">I love the beauty of a wedding day, the style, the energy, and all the little details. But what I enjoy most is getting to know the people. Every couple is different, and I want the photographs we create to reflect that: elegant, genuine, and true to who you are.</p>
        <a class="wd-textlink" href="/about">Meet Luis</a>
      </div>
    </section>

    {/* LOVE STORIES — hidden for now (no real galleries yet). To restore, remove
        this comment wrapper; the `loveStories` data is still computed above. Swap
        the "Coming soon" block back for the {loveStories.map(...)} card grid when
        real love-story photos are ready.
    <section class="wd-stories" aria-labelledby="wd-stories-title">
      <div class="wd-container">
        <div class="wd-stories__head" data-reveal>
          <div>
            <p class="wd-eyebrow">Love stories</p>
            <h2 id="wd-stories-title" class="wd-display wd-stories__title">Real people. <em>Real connections.</em></h2>
          </div>
          <a class="wd-textlink" href="/weddings/stories">View more love stories</a>
        </div>
        <div class="wd-stories__soon" data-reveal>
          <p class="wd-eyebrow wd-eyebrow-no-line wd-stories__soon-eyebrow">Coming soon</p>
          <p class="wd-stories__soon-text">Real love stories are on their way. Check back soon.</p>
        </div>
      </div>
    </section>
    */}

    <!-- CLOSING CTA -->
    <section class="wd-cta" aria-labelledby="wd-cta-title">
      <div class="wd-cta__image" data-parallax>
        <Pic src={ctaImage} alt="A couple walking together at golden hour." sizes="100vw" />
      </div>
      <div class="wd-cta__veil" aria-hidden="true"></div>
      <div class="wd-container wd-cta__content" data-reveal>
        <p class="wd-eyebrow wd-cta__eyebrow">An Invitation</p>
        <h2 id="wd-cta-title" class="wd-display wd-cta__title">I'd love to hear your love story.</h2>
        <p class="wd-about__para">Tell me what you're envisioning for your wedding. I'd love to get to know you both and explore how we can bring it to life.</p>

        <a class="wd-btn" href="/weddings/inquire">Book your consultation <span class="wd-btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <WeddingsFooter />
  <SiteMotion />
</Base>
