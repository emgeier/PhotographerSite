---
import Base from '../../layouts/Base.astro';
import WeddingsHeader from '../../components/WeddingsHeader.astro';
import WeddingsFooter from '../../components/WeddingsFooter.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import { getEntry } from 'astro:content';
import '../../styles/wedding.css';

const wed = await getEntry('settings', 'weddings-engagements');
const heroImage = wed?.data.wedEngagementsHeroImage ?? '/images/ms-muse-2.webp';
const videoImage = wed?.data.wedEngagementsVideoImage ?? '/images/story-portrait.webp';
const ctaImage = wed?.data.wedEngagementsCtaImage ?? '/images/portfolio-closing.webp';

// Gallery photos. Prefer the CMS-managed list (settings/weddings-engagements.json
// → wedEngagementsGallery); fall back to the built-in placeholder set when the
// CMS list is empty/absent. CMS items are { image, alt } string paths.
const P = (n) => `/images/muses/portrait-0${n}.webp`;
const fallbackGallery = [
  { src: P(5), alt: 'A couple sharing a quiet moment at golden hour.' },
  { src: '/images/ms-muse-2.webp', alt: 'A couple walking through a colonnade.' },
  { src: P(6), alt: 'A black-and-white embrace.' },
  { src: P(7), alt: 'A couple seated on stone steps.' },
  { src: '/images/story-portrait.webp', alt: 'A couple with a city skyline behind them.' },
  { src: P(4), alt: 'A couple nose-to-nose in soft light.' },
  { src: '/images/ms-muse-5.webp', alt: 'A couple walking a city street.' },
  { src: P(2), alt: 'An engagement ring detail.' },
  { src: P(8), alt: 'A couple embracing at sunset.' },
  { src: '/images/ms-muse-6.webp', alt: 'A joyful lift at golden hour.' },
  { src: P(9), alt: 'A black-and-white tender moment.' },
  { src: '/images/portfolio-film.webp', alt: 'A couple in a field at dusk.' },
];
const gallery =
  wed?.data.wedEngagementsGallery && wed.data.wedEngagementsGallery.length > 0
    ? wed.data.wedEngagementsGallery.map((g) => ({ src: g.image, alt: g.alt ?? '' }))
    : fallbackGallery;
---
<Base
  title="The Engagement Portfolio — Luis Quintana Studio"
  description="A collection of real love stories, from quiet moments to grand adventures — all about your story."
>
  <main class="wd wd-page" id="main-content">
    <!-- HERO -->
    <section class="wd-hero wd-subhero">
      <WeddingsHeader />
      <div class="wd-hero__image" data-parallax>
        <Pic src={heroImage} alt="A couple embracing with a city skyline at sunset." priority sizes="100vw" />
      </div>
      <div class="wd-hero__veil" aria-hidden="true"></div>
      <div class="wd-container wd-hero__content">
        <p class="wd-subhero__kicker" data-hero-item>The</p>
        <h1 class="wd-display wd-subhero__title wd-subhero__title--stack" data-hero-item>Engagement<br />Portfolio</h1>
        <p class="wd-hero__lede" data-hero-item>A collection of real love stories, from quiet moments to grand adventures, all about your story.</p>
      </div>
    </section>

    <!-- COLLECTION HEAD + GALLERY -->
    <section class="wd-gallery" id="wd-collection" aria-labelledby="wd-coll-title">
      <div class="wd-container">
        <div class="wd-collhead" data-reveal>
          <p class="wd-eyebrow wd-collhead__eyebrow">A collection</p>
          <h2 id="wd-coll-title" class="wd-display wd-collhead__title">Of beginnings</h2>
          <span class="wd-rule wd-collhead__rule" aria-hidden="true"></span>
          <p class="wd-collhead__intro">A look into a collection of real engagement sessions, each one unique, each one a true reflection of the couples I have the honor to photograph. Real moments. Real people. Real love.</p>
        </div>
        <div class="wd-gallery__grid" style="margin-top: 46px;">
          {gallery.map((g, i) => (
            <button
              type="button"
              class="wd-gallery__item"
              data-gallery-item
              data-reveal
              aria-label={`View engagement photograph ${i + 1} larger`}
            >
              <Pic src={g.src} alt={g.alt} sizes="(max-width: 620px) 50vw, 33vw" />
            </button>
          ))}
        </div>
      </div>
    
    </section>

    <!-- CLOSING CTA -->
    <section class="wd-cta" aria-labelledby="wd-cta-title">
      <div class="wd-cta__image" data-parallax>
        <Pic src={ctaImage} alt="A couple embracing against a sunset skyline." sizes="100vw" />
      </div>
      <div class="wd-cta__veil" aria-hidden="true"></div>
      <div class="wd-container wd-cta__content" data-reveal>
        <p class="wd-eyebrow wd-cta__eyebrow">Your story starts here</p>
        <h2 id="wd-cta-title" class="wd-display wd-cta__title">Your story starts here.</h2>
        <p class="wd-cta__para">Engagement sessions are a chance to celebrate your connection, create beautiful memories together, and get comfortable in front of the camera before the big day.</p>
        <a class="wd-btn" href="/weddings/inquire">Book your consultation <span class="wd-btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <WeddingsFooter />

  <!-- Engagement gallery lightbox — same native-<dialog> mechanism as the muse
       portfolio / wedding portfolio galleries (initStoryGallery, driven by
       [data-gallery-item] triggers + the #st-gallery-* contract). The
       gallery-dialog styles live in wedding.css. -->
  <dialog class="dialog gallery-dialog" id="st-gallery-dialog" aria-labelledby="wd-eng-gallery-label">
    <form method="dialog">
      <button class="dialog-close dialog-close--light" type="submit" aria-label="Close gallery">
        <span aria-hidden="true">×</span>
      </button>
    </form>
    <div class="gallery-dialog__heading">
      <p class="eyebrow" id="wd-eng-gallery-label">Of beginnings</p>
    </div>
    <div class="gallery-stage">
      <button class="gallery-arrow" type="button" data-st-gallery-prev aria-label="Previous photograph">
        <span aria-hidden="true">←</span>
      </button>
      <figure>
        <img id="st-gallery-image" class="gallery-stage__image" src={gallery[0].src} alt="An engagement photograph from the collection." />
      </figure>
      <button class="gallery-arrow" type="button" data-st-gallery-next aria-label="Next photograph">
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <p id="st-gallery-count" class="gallery-count" aria-live="polite">01 / {String(gallery.length).padStart(2, '0')}</p>
  </dialog>

  <SiteMotion />
  <script>
    import { initStoryGallery } from '../../scripts/portfolio.ts';
    initStoryGallery();
  </script>
</Base>
