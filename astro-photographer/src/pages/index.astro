---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const stories = [
  {src:'/images/story-1.svg', title:'Strength in softness'},
  {src:'/images/story-2.svg', title:'A new perspective'},
  {src:'/images/story-3.svg', title:'More than a portrait'}
];
---
<Base>
  <main>
    <section class="hero"><Header/><div class="wrap hero-copy"><p class="display hero-title">A portrait<br/>experience for<br/>women worth<br/>seeing.</p><p class="eyebrow">YOUR BEAUTY. REDISCOVERED.</p><a class="button" href="/contact">Begin your transformation</a></div><img class="hero-photo" src="/images/hero.svg" alt="Placeholder for hero portrait" /></section>

    <section class="intro wrap" id="portfolio"><img src="/images/look-again.svg" alt="Placeholder portrait"/><div><h1 class="display">Look Again.</h1><p class="eyebrow">A FRESH PERSPECTIVE.</p><span class="rule"></span><p class="eyebrow">YOU. IN FULL.</p><a class="button" href="/portfolio">Explore the portfolio</a></div></section>

    <section class="experience" id="experience"><img class="experience-photo" src="/images/exp-band.svg" alt="" aria-hidden="true" /><div class="wrap"><div class="experience-head"><div><p class="eyebrow">THE EXPERIENCE</p><h2 class="display">Not transformed,<br/>revealed.</h2></div><p>Every part of the experience is shaped around you—your personality, your style, your story, and how you want to be seen.</p></div><div class="steps"><article><b>01</b><span></span><h3>CONSULTATION</h3><p>A personal, in-depth conversation to understand your vision, preferences, and what makes you, uniquely you.</p></article><article><b>02</b><span></span><h3>SESSION</h3><p>A relaxed, guided portrait experience, designed to help you feel confident, empowered, and truly seen.</p></article><article><b>03</b><span></span><h3>REVEAL</h3><p>A private, cinematic unveiling of your portraits—a celebration of you, with options for artwork and collections you'll love.</p></article></div></div></section>

    <section class="stories wrap" id="stories"><h2>MUSE STORIES</h2><p class="eyebrow">EVERY WOMAN. A STORY WORTH SEEING.</p><div class="story-grid">{stories.map(s => <article><img src={s.src} alt="Photography placeholder"/><h3>{s.title}</h3><span></span></article>)}</div><a class="text-link" href="/stories">View all stories →</a></section>

    <section class="final-cta"><div class="wrap"><div><h2 class="display">Your Turn.</h2><span class="rule left"></span><p class="eyebrow">A PORTRAIT EXPERIENCE<br/>CREATED FOR YOU.</p><a class="button" href="/contact">Begin your consultation</a></div></div><img src="/images/your-turn.svg" alt="Placeholder portrait"/></section>
  </main><Footer/>
</Base>
