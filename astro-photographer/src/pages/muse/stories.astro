---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import '../../styles/codex-base.css';
import '../../styles/codex-content.css';
import { getCollection, getEntry } from 'astro:content';

// Hero + band images (look-again / in-motion / closing CTA) are CMS-editable
// via settings/stories.json; each falls back to its own /images/* default.
const st = await getEntry('settings', 'stories');
const hero = st?.data.storiesHeroImage ?? '/images/stories-hero.webp';
const lookAgainImage = st?.data.lookAgainImage ?? '/images/ms-look-again.webp';
const motionImage = st?.data.motionImage ?? '/images/ms-motion.webp';
const storiesCtaImage = st?.data.storiesCtaImage ?? '/images/ms-cta.webp';

const entries = (await getCollection('muses')).sort((a, b) => a.data.order - b.data.order);
const muses = entries.map(e => ({
  src: e.data.cardImage, slug: e.id, n: e.data.number, name: e.data.name, tag: e.data.tagline,
}));
// Featured muse: the entry marked `featured`, else the first ordered entry.
// `featured` is `undefined` only when the collection is empty — every
// derivation below is guarded so a zero-entry collection never throws at build.
const featured = entries.find(e => e.data.featured) ?? entries[0];
const fallbackPara = 'Heather came to this experience at a moment of change — ready to see herself with fresh eyes.';
const featuredPara = featured?.data.featuredPara ?? fallbackPara;
// All muses as featured-rotator slides (client script cycles through these).
const featuredList = entries.map(e => ({
  slug: e.id,
  number: e.data.number,
  name: e.data.name,
  tagline: e.data.tagline,
  image: e.data.cardImage,
  para: e.data.featuredPara ?? featuredPara,
}));
const featuredIndex = featured
  ? Math.max(0, entries.findIndex(e => e.id === featured.id))
  : 0;
---
<Base title="Muse Stories — The Glam Muse Experience" description="Portraits are only part of the story. Meet the women behind them.">
  <main id="main-content">
    <!-- HERO: Codex .hero masthead (absolute Header, hero__image + veil,
         hero__content), parallax on the hero image, line-mask title lines.
         Mirrors experience.astro / portfolio.astro so the pages stay consistent. -->
      
    <section class="ms2-hero hero" id="stories" aria-labelledby="stories-hero-title">
      <Header />
      <div class="hero__image" data-hero-image data-parallax>
        <Pic
          src={hero}
          alt="A softly lit editorial portrait introducing the muse stories."
          priority
          sizes="100vw"
        />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="container hero__content">
        <h1 id="stories-hero-title" class="hero__title ms2-hero__title">
          <span class="line-mask"><span data-hero-line>Muse</span></span>
          <span class="line-mask"><span data-hero-line>Stories</span></span>
        </h1>
        <p class="hero__subtitle" data-hero-item>Every woman. A story worth telling.</p>
        <a class="button" href="#stories-featured" data-hero-item>Meet the muses</a>
      </div>
    </section>

    <!-- FEATURED MUSE: editorial two-column band. The rotator script at the
         bottom mutates the ids/attrs below (#ms-featured-photo, -label, -name,
         -tag, -para, -link, -current, [data-featured-prev/next]). The featured
         portrait stays a passthrough <img> (string cardImage) so the script can
         set .src at runtime — it is intentionally NOT routed through Pic and
         NOT given data-parallax. Guarded so an empty collection never throws. -->
    {featured && (
      <section class="ms2-featured" id="stories-featured" aria-labelledby="ms-featured-name">
        <div class="content-container ms2-featured__row" data-featured-rotator>
          <div class="ms2-featured__photo image-frame">
            <img id="ms-featured-photo" src={featured.data.cardImage} alt={`Portrait of ${featured.data.name}`} />
          </div>
          <div class="ms2-featured__copy" data-reveal>
            <h2 class="ms2-featured__name display-title" id="ms-featured-name">{featured.data.name}</h2>
            <p class="ms2-featured__tag" id="ms-featured-tag">{featured.data.tagline}</p>
            <p class="ms2-featured__para" id="ms-featured-para">{featuredPara}</p>
            <a class="button ms2-featured__link" id="ms-featured-link" href={`/muse/stories/${featured.id}`}>Read her story <span aria-hidden="true">→</span></a>
          </div>
          <div class="ms2-featured__nav" aria-hidden="true">
            <span class="ms2-featured__count"><span id="ms-featured-current">{String(featuredIndex + 1).padStart(2, "0")}</span><br />/<br />{String(featuredList.length).padStart(2, "0")}</span>
          </div>
        </div>
        <div class="content-container ms2-featured__controls">
          <button class="ms2-arrow" type="button" data-featured-prev aria-label="Previous muse">←</button>
          <button class="ms2-arrow" type="button" data-featured-next aria-label="Next muse">→</button>
        </div>
        <script type="application/json" id="ms-featured-data" set:html={JSON.stringify(featuredList)}></script>
      </section>
    )}

    <!-- MEET THE MUSES: centered heading + 3-up grid of story cards, each
         linking /stories/{entry.id} in collection order. Card photos route
         through Pic (string cardImage → passthrough <img>) and are parallaxed. -->
    <section class="ms2-meet" aria-labelledby="ms-meet-title">
      <div class="content-container">
        <div class="ms2-meet__head" data-reveal>
          <p class="eyebrow">The women</p>
          <h2 id="ms-meet-title" class="ms2-meet__title display-title">
            <span class="short-rule" aria-hidden="true"></span>Meet the muses<span class="short-rule" aria-hidden="true"></span>
          </h2>
          <p class="ms2-meet__sub">Every woman. A different story.</p>
        </div>
        <div class="ms2-grid">
          {muses.map(m => (
            <a class="ms2-card" href={`/muse/stories/${m.slug}`} data-reveal>
              <span class="ms2-card__image image-frame" data-parallax>
                <Pic src={m.src} alt={`A portrait of ${m.name}.`} sizes="(max-width: 768px) 100vw, 33vw" />
              </span>
              <span class="ms2-card__name display-title">{m.name}</span>
              <br/>
              <span class="ms2-card__tag">{m.tag}</span>
              <span class="short-rule" aria-hidden="true"></span>
              <span class="ms2-card__link">Read her story <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- LOOK AGAIN. — dark tonal band with a parallaxed portrait. -->
    <section class="ms2-look" aria-labelledby="ms-look-title">
      <div class="content-container ms2-look__row">
        <div class="ms2-look__copy" data-reveal>
          <h2 id="ms-look-title" class="ms2-look__title display-title">Look again.</h2>
          <p class="ms2-look__sub">A fresh perspective.</p>
          <span class="short-rule" aria-hidden="true"></span>
        </div>
        <figure class="ms2-look__photo image-frame" data-parallax>
          <Pic src={lookAgainImage} alt="An editorial portrait inviting a fresh perspective." sizes="(max-width: 768px) 100vw, 440px" />
        </figure>
        <p class="ms2-look__para">Every woman carries a story — shaped by where she's been, who she is now, and what she's still becoming.</p>
      </div>
    </section>

    <!-- IN MOTION. — teaser placeholder. Poster + play affordance only (plain
         link), NO wired video player and NO video <dialog> (Req 5.1 / 5.2). -->
    <section class="ms2-motion" aria-labelledby="ms-motion-title">
      <div class="content-container ms2-motion__row">
        <a class="ms2-video" href="#stories" aria-label="Press play">
          <Pic src={motionImage} alt="A video poster frame from the muse stories." sizes="(max-width: 768px) 100vw, 66vw" />
          <span class="ms2-play" aria-hidden="true"></span>
          <span class="ms2-video__caption">Press play</span>
        </a>
        
        <div class="ms2-motion__copy" data-reveal>
          <p class="eyebrow">The muses</p>
          <h2 id="ms-motion-title" class="ms2-motion__title display-title">In motion.</h2>
          <span class="short-rule" aria-hidden="true"></span>
          <p class="ms2-motion__para">Movement. Laughter. Quiet moments.</p>
        </div>
      </div>
    </section>

    <!-- CLOSING CTA: Codex closing treatment with a .button link to /inquire. -->
    <section class="ms2-cta" id="inquire" aria-labelledby="ms-cta-title">
      <div class="ms2-cta__image" data-parallax>
        <Pic src={storiesCtaImage} alt="A soft editorial portrait inviting you to imagine your own story." sizes="100vw" />
      </div>
      <div class="ms2-cta__veil" aria-hidden="true"></div>
      <div class="content-container ms2-cta__content" data-reveal>
        <p class="eyebrow">The Glam Muse Experience</p>
        <h2 id="ms-cta-title" class="ms2-cta__title display-title">You've seen<br />their stories.</h2>
        <p class="ms2-cta__italic">Now imagine yours.</p>
        <span class="short-rule" aria-hidden="true"></span>
        <p class="ms2-cta__sub">What could your story look like?</p>
        <a class="button" href="/muse/inquire">Book your consultation</a>
      </div>
    </section>
  </main>
  <Footer />
  <SiteMotion />
  <script>
    // Featured-muse rotator: the prev/next arrows cycle the featured block
    // through all muses (data embedded in #ms-featured-data). Progressive
    // enhancement — with JS off, the server-rendered featured muse still shows.
    const dataEl = document.getElementById("ms-featured-data");
    const rotator = document.querySelector("[data-featured-rotator]");
    if (dataEl && rotator) {
      const slides = JSON.parse(dataEl.textContent || "[]");
      if (slides.length > 1) {
        const photo = document.getElementById("ms-featured-photo");
        const label = document.getElementById("ms-featured-label");
        const name = document.getElementById("ms-featured-name");
        const tag = document.getElementById("ms-featured-tag");
        const para = document.getElementById("ms-featured-para");
        const link = document.getElementById("ms-featured-link");
        const current = document.getElementById("ms-featured-current");
        const total = slides.length;
        // Start at the server-rendered featured muse.
        let i = Math.max(0, slides.findIndex((s) => label && s.number === label.textContent));
        const pad = (n) => String(n).padStart(2, "0");
        function render() {
          const s = slides[i];
          if (photo) { photo.src = s.image; photo.alt = "Portrait of " + s.name; }
          if (name) name.textContent = s.name;
          if (tag) tag.textContent = s.tagline;
          if (para) para.textContent = s.para;
          if (link) link.setAttribute("href", "/stories/" + s.slug);
          if (current) current.textContent = pad(i + 1);
        }
        const go = (step) => { i = (i + step + total) % total; render(); };
        document.querySelector("[data-featured-prev]")?.addEventListener("click", () => go(-1));
        document.querySelector("[data-featured-next]")?.addEventListener("click", () => go(1));
      }
    }
  </script>
</Base>
