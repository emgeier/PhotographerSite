---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import { getEntry } from 'astro:content';
import '../../styles/codex-base.css';
import '../../styles/codex-content.css';

// Page images are CMS-editable via settings/experience.json; each falls back to
// its original /images/* path when the entry (or a field) is absent. All are
// string paths, so Pic emits a passthrough <img> the CMS can swap freely.
const ex = await getEntry('settings', 'experience');
const heroImage = ex?.data.heroImage ?? '/images/ex-hero.png';
const ctaImage = ex?.data.ctaImage ?? '/images/ex-cta.png';
const processImages = ex?.data.processImages ?? [
  '/images/ex-process-1.webp', '/images/ex-process-2.png', '/images/ex-process-3.webp',
];
const insideImages = ex?.data.insideImages ?? [
  '/images/ex-inside-1.png', '/images/ex-inside-2.png', '/images/ex-inside-3.png', '/images/ex-inside-4.png',
];

// Step copy stays in-page; the image for each step comes from processImages[i].
const stepCopy = [
  { n: '01', t: 'CONSULTATION', p: 'We\u2019ll connect to learn about you\u2014 your vision, your style, and what you want from this experience.' },
  { n: '02', t: 'SESSION', p: 'Professional hair and makeup, full direction, and a relaxed, empowering photoshoot.' },
  { n: '03', t: 'REVEAL', p: 'See your images the same day in a private reveal\u2014 a time to celebrate you.' },
];
const steps = stepCopy.map((s, i) => ({ ...s, src: processImages[i] ?? '' }));
const inside = insideImages;
---
<Base
  title="The Experience — The Glam Muse Experience"
  description="A simple, intentional process designed to make you feel confident, comfortable, and fully yourself from start to finish."
>
  <main id="main-content">
    <!-- HERO: Codex .hero masthead treatment (absolute Header, hero__image + veil,
         hero__content), parallax on the hero image, line-mask title lines. -->
    <section class="ex2-hero hero" id="experience" aria-labelledby="experience-hero-title">
      <Header />
      <div class="hero__image" data-hero-image data-parallax>
        <Pic
          src={heroImage}
          alt="A softly lit editorial portrait from The Glam Muse Experience experience."
          priority
          sizes="100vw"
        />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="container hero__content">
        <h1 id="experience-hero-title" class="hero__title ex2-hero__title display-title">
          <span class="line-mask"><span data-hero-line>An experience</span></span>
          <span class="line-mask"><span data-hero-line>that feels</span></span>
          <span class="line-mask"><span data-hero-line>like <em>you.</em></span></span>
        </h1>
        <p class="ex2-hero__lede" data-hero-item>Your story, your personality, your style— brought together in portraits that reflect how you want to be seen.</p>
      </div>
    </section>

    <!-- PROCESS: eyebrow + display-title heading row + intro, then a 3-up grid
         of reveal cards (image, small numeral, short-rule, h3, copy). -->
    <section class="ex2-process" id="ex-process" aria-labelledby="ex-process-title">
      <div class="content-container">
        <div class="ex2-process__head" data-reveal>
          <div>
            <p class="eyebrow">The process</p>
            <h2 id="ex-process-title" class="display-title">Consultation.<br />Session.<br />Reveal.</h2>
          </div>
          <p class="ex2-process__intro">A simple, intentional process designed to make you feel confident, comfortable, and fully yourself from start to finish.</p>
        </div>
        <ol class="ex2-process__steps">
          {steps.map((s) => (
            <li class="ex2-step" data-reveal>
              <span class="image-frame">
                <Pic src={s.src} alt={`${s.t} — a moment from the experience.`} sizes="(max-width: 768px) 100vw, 33vw" />
              </span>
              <span class="ex2-step__number" aria-hidden="true">{s.n}</span>
              <span class="short-rule" aria-hidden="true"></span>
              <h3>{s.t}</h3>
              <p>{s.p}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- INSIDE THE EXPERIENCE: heading row + a 4-up .image-frame grid, each
         photo parallaxed to match Home/Portfolio content imagery. -->
    <section class="ex2-inside" aria-labelledby="ex-inside-title">
      <div class="content-container">
        <div class="ex2-inside__head" data-reveal>
          <div>
            <p class="eyebrow">Inside the experience</p>
            <h2 id="ex-inside-title" class="display-title">This time is yours.</h2>
          </div>
          <p class="ex2-inside__intro">From the moment you arrive to the final reveal, everything is considered so you can simply be present.</p>
        </div>
        <div class="ex2-inside__grid">
          {inside.map((src, i) => (
            <figure class="image-frame" data-reveal data-parallax>
              <Pic src={src} alt={`Inside the experience, moment ${i + 1}.`} sizes="(max-width: 768px) 50vw, 25vw" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- CLOSING CTA: Codex closing treatment with a .button link to /inquire. -->
    <section class="ex2-cta" id="inquire" aria-labelledby="ex-cta-title">
      <div class="ex2-cta__image" data-parallax>
        <Pic
          src={ctaImage}
          alt="A soft, editorial portrait inviting you to begin your own experience."
          sizes="100vw"
        />
      </div>
      <div class="ex2-cta__veil" aria-hidden="true"></div>
      <div class="content-container ex2-cta__content" data-reveal>
        <h2 id="ex-cta-title" class="display-title">Let this be<br /><em>your moment.</em></h2>
        <span class="short-rule" aria-hidden="true"></span>
        <a class="button" href="/muse/inquire">Book your consultation</a>
      </div>
    </section>
  </main>
  <Footer />
  <SiteMotion />
</Base>
