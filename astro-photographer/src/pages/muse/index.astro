---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SiteMotion from '../../components/SiteMotion.astro';
import Pic from '../../components/Pic.astro';
import { getCollection, getEntry } from 'astro:content';
// Codex home styles (shared Codex primitives + home sections). global.css is
// imported by Base.astro; this adds the Codex-aliased home look on top.
import '../../styles/codex-base.css';

// Stories teaser: first 3 muses by `order`, each card links to /stories/{id}.
const muses = (await getCollection('muses')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// Home images are CMS-editable via settings/home.json; each falls back to its
// own /images/* default. These are string paths (passthrough <img>), so the
// CMS can swap them per page — the heroes are no longer a shared placeholder.
const home = await getEntry('settings', 'home');
const hero = home?.data.homeHeroImage ?? '/images/home-hero.webp';
const portrait = home?.data.homePortraitImage ?? '/images/home-portrait.webp';
const closing = home?.data.homeClosingImage ?? '/images/home-closing.webp';
const experienceImage = home?.data.homeExperienceImage ?? '/images/home-experience-bg.webp';
---
<Base>
  <main id="main-content">
    <!-- HERO: Codex markup with data-hero-* motion hooks; hero image via Pic (priority/LCP). -->
    <section class="hero" id="home" aria-labelledby="hero-title">
      <Header />
      <div class="hero__image" data-hero-image data-parallax>
        <Pic
          src={hero}
          alt="A softly lit editorial portrait of a brunette woman seated in an ivory dress."
          priority
          sizes="100vw"
        />
      </div>
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="container hero__content">
        <h1 id="hero-title" class="hero__title">
          <span class="line-mask"><span data-hero-line>A portrait</span></span>
          <span class="line-mask"><span data-hero-line>experience to</span></span>
          <span class="line-mask"><span data-hero-line>tell your story.</span></span>
          <span class="line-mask"><span data-hero-line></span></span>
        </h1>
        <p class="hero__subtitle" data-hero-item>Your beauty. Retold.</p>
        <a class="button" href="/muse/inquire" data-hero-item>Book your consultation</a>
      </div>
    </section>

    <!-- PERSPECTIVE ("Look Again"): "Preview a portrait" links to /portfolio (default-to-Codex). -->
    <section class="perspective section" id="portfolio" aria-labelledby="perspective-title">
      <div class="container perspective__grid">
        <a class="portrait-button" href="/muse/portfolio" aria-label="Preview a portrait" data-reveal>
          <span class="image-frame perspective__image" data-parallax>
            <Pic
              src={portrait}
              alt="A black-and-white portrait of a woman turning gently toward the light."
              sizes="(max-width: 700px) 90vw, 410px"
            />
          </span>
          <span class="portrait-button__label">Preview a portrait <span aria-hidden="true">↗</span></span>
        </a>
        <div class="perspective__content" data-reveal>
          <h2 id="perspective-title" class="display-title">Look Again.</h2>
          <p class="eyebrow perspective__subtitle">A fresh perspective.</p>
          <span class="short-rule" aria-hidden="true"></span>
          <p class="eyebrow perspective__signature">You. In full.</p>
          <a class="button" href="/muse/portfolio">Explore the portfolio</a>
        </div>
      </div>
    </section>

    <!-- EXPERIENCE STEPS: full-bleed background image + dark overlay for strong
         contrast (same treatment as the Inquire "A Simple Beginning" band). The
         image is CMS-editable (home.json homeExperienceImage). -->
    <section class="experience section" id="experience" aria-labelledby="experience-title">
      <img class="experience__photo" src={experienceImage} alt="" aria-hidden="true" />
      <div class="container experience__inner">
        <div class="experience__intro">
          <div data-reveal>
            <p class="eyebrow">The experience</p>
            <h2 id="experience-title">Not transformed.<br />revealed.</h2>
          </div>
          <p class="experience__description" data-reveal>Every part of the experience is shaped around you—your personality, your style, your story, and how you want to be seen.</p>
        </div>
        <ol class="experience__steps">
          <li class="experience-step" data-reveal>
            <span class="experience-step__number" aria-hidden="true">01</span>
            <span class="short-rule" aria-hidden="true"></span>
            <h3>Consultation</h3>
            <p>A personal, in-depth conversation to understand your vision, preferences, and what makes you uniquely you.</p>
          </li>
          <li class="experience-step" data-reveal>
            <span class="experience-step__number" aria-hidden="true">02</span>
            <span class="short-rule" aria-hidden="true"></span>
            <h3>Session</h3>
            <p>A relaxed, guided portrait experience, designed to help you feel confident, empowered, and truly seen.</p>
          </li>
          <li class="experience-step" data-reveal>
            <span class="experience-step__number" aria-hidden="true">03</span>
            <span class="short-rule" aria-hidden="true"></span>
            <h3>Reveal</h3>
            <p>A private, cinematic unveiling of your portraits—a celebration of you, with options for artwork and collections you'll love.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- STORIES TEASER: shell ready for task 9.2 (getCollection('muses'), 3 cards -> /stories/{id}). 
    <section class="stories section" id="stories" aria-labelledby="stories-title">
      <div class="container stories__inner">
        <div class="stories__heading" data-reveal>
          <h2 id="stories-title">Muse stories</h2>
          <span class="short-rule" aria-hidden="true"></span>
          <p class="eyebrow">Every woman. A story worth telling.</p>
        </div>
        <div class="stories__grid">
          {muses.map((muse) => (
            <a class="story-card" href={`/muse/stories/${muse.id}`} data-reveal>
              <span class="story-card__image image-frame">
                <Pic
                  src={muse.data.cardImage}
                  alt={muse.data.name}
                  sizes="(max-width:700px) 90vw, 33vw"
                />
              </span>
              <span class="story-card__title">{muse.data.tagline ?? muse.data.name}</span>
              <span class="short-rule" aria-hidden="true"></span>
            </a>
          ))}
        </div>
        <div class="stories__more" data-reveal>
          <a class="text-link" href="/muse/stories">View all stories <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
    -->

    <!-- CLOSING / BOOKING: CTA to /inquire (no consultation dialog, no mailto). -->
    <section class="closing" id="inquire" aria-labelledby="closing-title">
      <div class="closing__image" data-parallax>
        <Pic
          src={closing}
          alt="A soft portrait from behind of a woman with an elegant updo, wearing an ivory blouse."
          sizes="100vw"
        />
      </div>
      <div class="closing__veil" aria-hidden="true"></div>
      <div class="container closing__content" data-reveal>
        <h2 id="closing-title" class="display-title">Your Turn.</h2>
        <span class="short-rule" aria-hidden="true"></span>
        <p class="eyebrow">A portrait experience<br />created for you.</p>
        <a class="button" href="/muse/inquire">Book your consultation</a>
      </div>
    </section>
  </main>
  <Footer />
  <SiteMotion />
</Base>
