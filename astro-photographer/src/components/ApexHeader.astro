---
// Apex studio hub masthead — the top-level "Luis Quintana Studio" brand that
// unites the Weddings and Glam Muse sections. Mirrors WeddingsHeader structure
// and the mobile-menu contract that motion.ts initNav() targets
// (#menu-toggle, #primary-nav, body.menu-open). Rendered light over the dark hero.
const links = [
  { href: '/weddings', label: 'Weddings & Engagements' },
  { href: '/muse', label: 'Glam Muse' },
] as const;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="lq-header">
<a class="brand" href="/" aria-label="LQ, home">

    <img class="lq-brand-image" src={'/images/LQSW.png'} alt="" aria-hidden="true" />
</a>

  <button
    class="menu-toggle lq-menu-toggle"
    id="menu-toggle"
    type="button"
    aria-controls="primary-nav"
    aria-expanded="false"
    aria-label="Open navigation"
  >
    <span></span><span></span>
  </button>
  <nav class="lq-nav primary-nav" id="primary-nav" aria-label="Main navigation">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
