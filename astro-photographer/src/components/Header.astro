---
// Shared masthead for all muse pages (Codex home/portfolio + legacy experience/stories/inquire).
// Markup/structure ported from the Codex header in Glammuse/index.html + css/styles.css,
// but the links are the REAL Astro routes.
//
// Selectors/attributes the mobile-menu toggle exposes for motion.ts initNav():
//   - toggle button:  #menu-toggle  (toggles aria-expanded "true"/"false")
//   - nav element:     #primary-nav  (gets/removes the .is-open class)
//   - body:            gets/removes the .menu-open class
// These match what the Codex js/main.js used, so initNav() can target them unchanged.

const links = [
  { href: '/muse/portfolio', label: 'Portfolio' },
  { href: '/muse/experience', label: 'The experience' },
] as const;



// Mark the active route so the header renders correctly on every page.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/muse' ? path === '/muse' : path === href || path.startsWith(href + '/');
---

<header class="site-header">


  <a class="brand" href="/muse" aria-label="The Glam Muse Experience, home">

    <span class="brand__top">THE</span>
    <span class="brand__name">GLAM MUSE</span>
    <span class="brand__bottom">EXPERIENCE</span>
  </a>
  
  <button
    class="menu-toggle"
    id="menu-toggle"
    type="button"
    aria-controls="primary-nav"
    aria-expanded="false"
    aria-label="Open navigation"
  >
    <span></span><span></span>
  </button>
  <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
    ))}
    <a class="nav-inquire" href="/muse/inquire" aria-current={isActive('/muse/inquire') ? 'page' : undefined}>Inquire</a>
  </nav>
</header>
