---
// Apex studio hub footer — top-level brand, nav, social and tagline. Mirrors
// WeddingsFooter structure with the hub's own .lq-footer* classes. Social set is
// Instagram / Facebook / Pinterest per the mockup; the Instagram glyph is reused
// from WeddingsFooter.
---
<footer class="lq-footer">
  <div class="lq-footer__inner">
    <div class="lq-footer__top">
      <a class="lq-brand lq-brand--footer" href="/home" aria-label="Luis Quintana Studio, back to top">
        <span class="lq-brand__name">LUIS QUINTANA STUDIO</span>
      </a>

      <nav class="lq-footer__nav" aria-label="Footer navigation">
        <a href="/home">Home</a>
        <a href="/weddings">Weddings &amp; Engagements</a>
        <!-- /muse arrives with the paths-restructure; forward-looking link. -->
        <a href="/muse">The Glam Muse Series</a>
        <!-- /about may not exist yet; forward-looking link. -->
        <a href="/about">About</a>
        <!-- Mockup labels this "Inquire"; points at /contact so it resolves today. -->
        <a href="/contact">Inquire</a>
      </nav>

      <ul class="lq-footer__social" aria-label="Social media">
        <li>
