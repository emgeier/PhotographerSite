---
// Weddings site masthead — its own brand ("Luis Quintana Studio") and nav,
// distinct from the Glam Muse Header. Mirrors the mobile-menu contract that
// motion.ts initNav() targets (#menu-toggle, #primary-nav, body.menu-open).
const links = [
  { href: '/weddings', label: 'Weddings' },
  { href: '/weddings/engagements', label: 'Engagements' },
  { href: '/weddings/stories', label: 'Love Stories' },
] as const;

const discover = [
  { href: '/weddings/about', label: 'About' },
  { href: '/weddings/faq', label: 'FAQ' },
  { href: '/weddings/testimonials', label: 'Testimonials' },
  { href: '/weddings/experience', label: 'The Experience' },
] as const;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  path === href || path.startsWith(href + '/');
const discoverActive = discover.some((d) => isActive(d.href));
---
<header class="wd-header">
    <a class="brand" href="/" aria-label="LQ, home">

    <img class="lq-brand-image" src={'/images/LQSB.png'} alt="" aria-hidden="true" />
</a>
  <button
    class="menu-toggle wd-menu-toggle"
    id="menu-toggle"
    type="button"
    aria-controls="primary-nav"
    aria-expanded="false"
    aria-label="Open navigation"
  >
    <span></span><span></span>
  </button>
  <nav class="wd-nav primary-nav" id="primary-nav" aria-label="Main navigation">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
    ))}
    <div class="wd-nav__discover">
      <button
        type="button"
        class="wd-nav__discover-toggle"
        aria-expanded="false"
        aria-current={discoverActive ? 'page' : undefined}
      >Discover <span class="wd-nav__caret" aria-hidden="true">▾</span></button>
      <div class="wd-nav__menu">
        {discover.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
      </div>
    </div>
    <a class="wd-nav__inquire" href="/weddings/inquire">Inquire</a>
  </nav>
</header>
